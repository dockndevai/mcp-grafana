# --- Connection -------------------------------------------------------------
# Base URL of the Grafana instance.
GRAFANA_URL=http://localhost:3000
# Service-account token (Bearer). Administration -> Service accounts -> Add token.
# Use a Viewer-role account for read-only use. Required.
GRAFANA_TOKEN=
# Request timeout in milliseconds.
GRAFANA_TIMEOUT_MS=30000

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
#   read-only  -> the 11 read tools (health, search, get_dashboard, query_datasource, ...)
#   read-write -> adds create_or_update_dashboard, create_folder, create_annotation
#   admin      -> adds delete_dashboard, delete_folder, delete_annotation (need GRAFANA_ALLOW_DELETE=true)
GRAFANA_MODE=read-only
# Comma-separated folder allowlist (UID or title). Empty = all. Writes/deletes only.
GRAFANA_FOLDER_ALLOWLIST=
# Folders that can be read but never modified or deleted, e.g. production.
GRAFANA_PROTECTED_FOLDERS=
# Comma-separated datasource allowlist (UID or name) for query_datasource. Empty = all.
GRAFANA_DATASOURCE_ALLOWLIST=
# Destructive ops (delete dashboard/folder/annotation) require this in addition to admin mode.
GRAFANA_ALLOW_DELETE=false
# Validate + log writes without executing them.
GRAFANA_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
GRAFANA_AUDIT_LOG=true
